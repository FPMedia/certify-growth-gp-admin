NEXT_PUBLIC_API_URL=/api
GATEWAY_URL=http://127.0.0.1:8080
NEXT_PUBLIC_DEV_AUTH=true

# Origin of the user-facing web app ("Main app" link). Read at runtime — do not
# rely on NEXT_PUBLIC_* here; those are inlined at `next build` and are not Docker ARGs.
# Local: http://localhost:3000. Railway: https://web-production-aae47.up.railway.app
# This app uses the existing GATEWAY_URL / Firebase / catalog / identity — same
# backends as web. Do not create new API services for admin.
WEB_URL=http://localhost:3000
# Optional alias still honoured if WEB_URL is unset.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# SYS_ADMIN lives on the identity service, not this app.
# Railway: identity service → SYS_ADMIN=<comma-separated emails>

# Firebase web app config (same project as certify-growth-gp-web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
